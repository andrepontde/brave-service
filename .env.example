POSTGRES_DB=brave_service
POSTGRES_USER=brave_service
POSTGRES_PASSWORD=change_this_password

# The app runs inside Compose, so PostgreSQL is reached through the service name.
DATABASE_URL=postgresql+psycopg://brave_service:change_this_password@db:5432/brave_service

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
